{
  "name": "omg-draft-seer",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "build:tauri:test": "tsx scripts/build-tauri-test.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:tauri": "wdio run wdio.tauri.conf.ts",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "check:staged": "lint-staged",
    "check": "npm run format:check && npm run format:rust:check && npm run build && npm test && npm run lint:rust && npm run verify:runtime",
    "sync:data": "tsx scripts/sync-windrun.ts",
    "build:icons": "tsx scripts/build-icon-signatures.ts",
    "build:hero-map": "tsx scripts/build-hero-selection-map.ts",
    "cache:icons": "tsx scripts/cache-ability-icons.ts",
    "build:fixture-labels": "tsx scripts/generate-fixture-labels.ts",
    "verify:icons": "tsx scripts/verify-icon-signatures.ts",
    "verify:runtime": "tsx scripts/verify-runtime-assets.ts",
    "verify:macos-bundle": "tsx scripts/verify-macos-bundle.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-popover": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.7",
    "@vitejs/plugin-react": "6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "jpeg-js": "^0.4.4",
    "lucide-react": "1.25.0",
    "pngjs": "7.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^17.0.11",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.1.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@wdio/cli": "^9.27.1",
    "@wdio/globals": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/native-utils": "^2.3.0",
    "@wdio/spec-reporter": "^9.27.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "webdriverio": "^9.27.1"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,md,yml,yaml}": "prettier --write"
  }
}
